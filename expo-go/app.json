{
  "expo": {
    "name": "Hesap",
    "slug": "hesap",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hesapgo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "wasy.system.hesap",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Mesai QR kodunu okutmak için kameraya erişim gerekiyor."
      }
    },
    "android": {
      "package": "wasy.system.hesap.expo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "extra": {
      "baseUrl": "https://pamukkaleturizm.info",
      "eas": {
        "projectId": "efc72129-3fef-468b-a646-c0b8ce98bb36"
      }
    },
    "owner": "wasycimm",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Mesai QR kodunu okutmak için kameraya erişim gerekiyor."
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
